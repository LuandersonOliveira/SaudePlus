{
  "name": "saude-plus-server",
  "version": "1.0.0",
  "private": true,
  "description": "API Node/Express + MySQL do Saúde+",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:local": "node scripts/run-local.js",
    "test": "node --test \"test/*.test.js\"",
    "test:race": "node --test \"test/race/*.test.js\"",
    "test:all": "npm test && npm run test:race",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-v3-demo.js",
    "link:professionals-users": "node scripts/link-professionals-to-users.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:cpf:rehash": "node migrations/0002_cpf_hmac.js --rehash",
    "purge:retention": "node scripts/purge-retention.js",
    "anonimizar:excluidos": "node scripts/anonimizar-excluidos.js",
    "mfa:reset": "node scripts/mfa-reset.js",
    "backup": "node scripts/backup.js",
    "sync:cnes": "node scripts/sync-cnes.js",
    "sync:alerts": "node scripts/sync-alerts.js",
    "test:rnds": "node scripts/test-rnds.js",
    "test:cns": "node scripts/test-cns.js",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.0",
    "nodemailer": "^10.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  }
}
