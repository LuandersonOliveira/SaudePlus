{
  "name": "saude-plus-server",
  "version": "1.0.0",
  "private": true,
  "description": "API Node/Express + MySQL do Saúde+",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:race": "node --test \"test/race/*.test.js\"",
    "test:all": "npm test && npm run test:race",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-v3-demo.js",
    "migrate:supabase": "node scripts/migrate-supabase.js",
    "migrate": "mysql --default-character-set=utf8mb4 -u %DB_USER% -p%DB_PASSWORD% %DB_NAME% < migration_001.sql",
    "migrate:v3": "node scripts/migrate-v3.js",
    "migrate:security": "node scripts/migrate-security.js",
    "migrate:privacy": "node scripts/migrate-privacy.js",
    "migrate:interop": "node scripts/migrate-interop.js",
    "migrate:audit": "node scripts/migrate-audit.js",
    "migrate:audit:details": "node scripts/migrate-audit-details.js",
    "migrate:mfa:replay": "node scripts/migrate-mfa-replay.js",
    "migrate:all": "npm run migrate:v3 && npm run migrate:security && npm run migrate:privacy && npm run migrate:interop && npm run migrate:audit && npm run migrate:audit:details && npm run migrate:mfa:replay",
    "purge:retention": "node scripts/purge-retention.js",
    "backup": "node scripts/backup.js",
    "sync:cnes": "node scripts/sync-cnes.js",
    "sync:alerts": "node scripts/sync-alerts.js",
    "test:rnds": "node scripts/test-rnds.js",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
