PORT=4000
# Lista explícita (vírgula separa múltiplas). Sem '*' — origem fora da lista é bloqueada.
# Deve bater EXATAMENTE com a URL do front (esquema + host + porta).
# O `npm run doctor` verifica isso: se as duas divergirem, o navegador barra
# todo fetch com 403 e o sintoma é "Failed to fetch" no login, sem nenhuma
# mensagem no terminal e com o painel vazio.
# Se mudar a porta do front (WEB_PORT), mude aqui também.
CORS_ORIGIN=http://localhost:8080
# Nº de proxies confiáveis entre o cliente e a API. 0 = desligado (dev local).
# Atrás de um nginx/Cloudflare: 1. Sem isto, req.ip é o IP do PROXY e o rate
# limit e o lockout de login passam a valer para o proxy inteiro.
TRUST_PROXY_HOPS=0
# NODE_ENV=production  # em produção: ativa cookie Secure no refresh
# Produção em UMA origem: o Express entrega o front React (web/dist) e a API passa a viver
# só em /api. Rode `npm run build:web` antes. 1 = liga, 0 = desliga; vazio = liga só com
# NODE_ENV=production e build presente. Com isto ligado, CORS_ORIGIN não é necessário
# (mesma origem) e APP_BASE_URL (link do e-mail de redefinição) deve ser a URL pública do site.
# SERVE_WEB=1
# WEB_DIST=../web/dist
# APP_BASE_URL=https://saude.exemplo.gov.br
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saude
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Chave AES-256 da cripto em coluna (CPF/RG/CNS). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Produção: use KMS/Vault, nunca commite a chave real.
# Chave da cripto em coluna (CPF/RG/CNS). SEM ELA O APP NÃO SOBE.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Para rodar LOCAL sem a chave, use `npm run dev` — que liga
# ALLOW_PLAINTEXT_DEV=1 de propósito. O caminho de produção (`npm run
# start:api`) não liga e continua recusando.
DATA_ENCRYPTION_KEY=

# Só para desenvolvimento local, se precisar rodar `node src/server.js`
# direto sem chave. NÃO defina em produção.
# ALLOW_PLAINTEXT_DEV=1
# Encarregado LGPD (art. 41) — exibido em privacy.html via GET /public/dpo
DPO_NAME=
DPO_EMAIL=
# Anos sem login até anonimização automática (purge-retention.js)
RETENTION_INACTIVE_YEARS=5
# --- Fase 2: interoperabilidade SUS ---
# CNES (público, sem credencial). 260850 = Lagoa de Itaenga/PE (IBGE 2608503 p/ InfoDengue).
CNES_MUNICIPIO_CODE=260850
INFODENGUE_GEOCODE=2608503
# RNDS (exige credenciamento: e-CNPJ ICP-Brasil + CNES em servicos-datasus.saude.gov.br)
RNDS_ENV=homologacao
RNDS_UF=pe
RNDS_CERT_PFX_PATH=
RNDS_CERT_PASS=
# Login Único Gov.br (exige client homologado em sso.acesso.gov.br)
GOVBR_BASE_URL=https://sso.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:4000/auth/govbr/callback
# CNS WebService (exige credenciamento DATASUS: e-CNPJ ICP-Brasil em
# servicos-datasus.saude.gov.br). Endpoint e caminho reais vêm do pacote
# técnico entregue no credenciamento — não preencha com um palpite.
CNS_WS_BASE_URL=
CNS_WS_LOOKUP_PATH=
CNS_WS_CERT_PFX_PATH=
CNS_WS_CERT_PASS=
# E-mail (SMTP genérico: serve para Gmail Workspace, SES, Mailgun ou um relay
# interno, trocando só estas variáveis). SEM SMTP_HOST o sistema funciona,
# mas o envio NÃO acontece — e isso fica registrado em
# `reminders.send_error` e na resposta da recuperação de senha. Nunca é
# fingido que saiu.
# 465 = TLS implícito; 587 = STARTTLS (padrão).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Saúde+ <nao-responda@saudeplus.local>
# Prazo do link de recuperação de senha (mesmo formato do JWT_REFRESH_EXPIRES_IN).
PASSWORD_RESET_EXPIRES_IN=1h
ADMIN_EMAIL=admin@saude.app
ADMIN_PASSWORD=troque-por-uma-senha-forte
