{
  "name": "saude-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Saúde+ — cuidado integrado Lagoa de Itaenga. Orquestra a API (server/) e o front React (web/).",
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix web install && npm run db:setup",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run start:local",
    "dev:web": "npm --prefix web run dev",
    "start": "npm run dev",
    "start:api": "node server/src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:migrate": "npm --prefix server run migrate:all",
    "db:seed": "npm --prefix server run seed:admin && npm --prefix server run seed:demo",
    "db:clean:keep-admin": "node server/scripts/clean-db-keep-admin.js",
    "test": "npm --prefix server test",
    "test:race": "npm --prefix server run test:race",
    "test:all": "npm --prefix server run test:all",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run test:all",
    "smoke-test": "npm --prefix server run smoke-test",
    "backup": "npm --prefix server run backup",
    "doctor": "node scripts/doctor.js",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "typecheck:web": "npm --prefix web run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
